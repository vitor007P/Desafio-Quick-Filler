# Imagem usada pela Vercel para rodar esta aplicação como um "Container
# Function" (ver vercel.json). É praticamente o mesmo Dockerfile do
# docker-compose local — a diferença é que aqui a porta vem da variável de
# ambiente $PORT. A Vercel espera o container escutando na porta 80 por
# padrão (só muda se você definir PORT nas configurações do projeto), por
# isso o default aqui é 80 em vez dos 8000 fixos do Dockerfile local.
#
# Por que precisa de um Dockerfile e não da runtime Python "pura" da Vercel:
# o Tesseract é um binário de sistema (instalado via apt-get), e a runtime
# Python padrão da Vercel só instala pacotes pip — ela não tem como instalar
# um executável do sistema operacional. Empacotando tudo num container, a
# gente controla o ambiente inteiro, exatamente como localmente.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=80

# tesseract-ocr-por: modelo de português — a maioria dos documentos trabalhistas
# brasileiros vem nesse idioma, e sem o pacote de idioma o Tesseract cai para
# inglês e erra sistematicamente acentos e formatação de data.
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-por \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY web ./web

# Em containers de função (Vercel/serverless) o disco é temporário e some a
# qualquer momento entre execuções — por isso apontamos o armazenamento para
# /tmp, a única pasta garantidamente gravável nesse tipo de ambiente. Isso é
# suficiente para o ciclo enviar→processar→revisar→baixar de uma sessão, mas
# não é armazenamento durável (é o mesmo espírito da retenção curta de 60
# minutos que a aplicação já aplica sozinha).
ENV STORAGE_DIR=/tmp/data

# A Vercel espera que o container escute na porta 80 por padrão (só usa outra
# se você definir PORT nas configurações do projeto) — por isso $PORT aqui
# vale 80, diferente do Dockerfile local (porta 8000 fixa).
EXPOSE 80

# $PORT só é sobrescrito se você definir essa env var nas configurações do
# projeto na Vercel; caso contrário cai no valor padrão 80 configurado acima
# (e localmente, docker run sem definir PORT também cai nesse padrão).
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port $PORT"]
